{
  "key": "deckSystem",
  "metaVersion": 2,
  "mockRole": "generic-producer",
  "promptHints": "Write the visual system before any slide exists: two or three grounds with a stated job each, a type scale with named extremes, four to six named compositions, the accent's one job in words. Assign a composition and a ground to every slide in spine.md. Pipeline directory: {pipelineDir}",
  "inputs": [{ "id": "spine", "type": "md" }],
  "outputs": [{ "id": "system", "type": "md", "filename": "visual-system.md", "artifactKind": "deck-system" }],
  "domain": "presentation",
  "displayName": "Visual System",
  "description": "Grounds, type scale, compositions and the accent — written down before the first slide.",
  "color": "violet",
  "icon": "<rect x=\"3\" y=\"4\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"4\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"15\" width=\"7\" height=\"5\" rx=\"1\"/><circle cx=\"17.5\" cy=\"17.5\" r=\"2.5\"/>",
  "agentFile": "worca-cc-deck-system.md",
  "runnerType": "producer",
  "asksQuestions": true,
  "questionsLocked": false,
  "questionsDefault": true,
  "requiresAssets": ["deck-preview"],
  "order": 12,
  "ask": {
    "forms": {
      "approve-system": {
        "version": 1,
        "title": "Approve the visual system",
        "data": {
          "type": "object",
          "required": ["headline", "grounds", "typeSteps", "compositions", "accent"],
          "properties": {
            "headline": {"type": "string", "maxLength": 240},
            "grounds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": ["id", "name", "hex"],
                "properties": {
                  "id": {"type": "string", "maxLength": 32},
                  "name": {"type": "string", "maxLength": 60},
                  "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "patternHint": "A #RRGGBB colour."},
                  "ink": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "patternHint": "A #RRGGBB colour."},
                  "job": {"type": "string", "maxLength": 200}
                }
              }
            },
            "typeSteps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": ["id", "name", "px"],
                "properties": {
                  "id": {"type": "string", "maxLength": 32},
                  "name": {"type": "string", "maxLength": 60},
                  "px": {"type": "integer", "minimum": 8, "maximum": 1080},
                  "family": {"type": "string", "maxLength": 80},
                  "weight": {"type": "integer", "minimum": 100, "maximum": 900}
                }
              }
            },
            "compositions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": {"type": "string", "maxLength": 32},
                  "name": {"type": "string", "maxLength": 80},
                  "job": {"type": "string", "maxLength": 200},
                  "slides": {"type": "integer", "minimum": 0, "maximum": 200}
                }
              }
            },
            "accent": {"type": "string", "maxLength": 400},
            "sheet": {"type": "file", "accept": ["image/png"]},
            "compositionsSheet": {"type": "file", "accept": ["image/png"]},
            "samples": {"type": "file", "accept": ["image/png"]}
          }
        },
        "answer": {
          "type": "object",
          "required": ["decision"],
          "properties": {
            "decision": {"type": "string", "enum": ["approve", "changes"], "default": "approve"},
            "changeAreas": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["grounds", "type", "compositions", "accent"]}
            },
            "notes": {"type": "string", "maxLength": 4000}
          }
        },
        "layout": [
          {"widget": "callout", "title": "Visual system", "bind": "data.headline", "tone": "info"},
          {
            "widget": "tabs",
            "tabs": [
              {
                "label": "Sheet",
                "children": [
                  {"widget": "image", "bind": "data.sheet", "caption": "Grounds, type ladder, accent and icons"},
                  {
                    "widget": "table",
                    "bind": "data.grounds",
                    "label": "Grounds",
                    "columns": [
                      {"key": "name", "label": "Ground"},
                      {"key": "hex", "label": "Colour", "mono": true},
                      {"key": "ink", "label": "Ink", "mono": true},
                      {"key": "job", "label": "Job"}
                    ]
                  },
                  {
                    "widget": "table",
                    "bind": "data.typeSteps",
                    "label": "Type scale",
                    "columns": [
                      {"key": "name", "label": "Step"},
                      {"key": "px", "label": "Size", "unit": "px", "align": "right"},
                      {"key": "family", "label": "Family"},
                      {"key": "weight", "label": "Weight", "align": "right"}
                    ]
                  },
                  {"widget": "callout", "title": "Accent", "bind": "data.accent", "tone": "warn"}
                ]
              },
              {
                "label": "Compositions",
                "children": [
                  {
                    "widget": "image",
                    "bind": "data.compositionsSheet",
                    "caption": "Each composition, filled with real slide titles"
                  },
                  {
                    "widget": "table",
                    "bind": "data.compositions",
                    "label": "Compositions",
                    "columns": [
                      {"key": "name", "label": "Composition"},
                      {"key": "job", "label": "Job"},
                      {"key": "slides", "label": "Slides", "align": "right"}
                    ]
                  }
                ]
              },
              {
                "label": "Samples",
                "children": [{"widget": "image", "bind": "data.samples", "caption": "The cover title on every ground"}]
              }
            ]
          },
          {
            "widget": "select",
            "field": "decision",
            "label": "Decision",
            "style": "segmented",
            "labels": {"approve": "Approve the system", "changes": "Apply my changes"},
            "tones": {"approve": "ok", "changes": "warn"},
            "help": "Anything you tick or write below counts as a change, whichever you pick."
          },
          {
            "widget": "multiselect",
            "field": "changeAreas",
            "label": "What should change?",
            "style": "chips",
            "labels": {"grounds": "Grounds", "type": "Type", "compositions": "Compositions", "accent": "Accent"}
          },
          {
            "widget": "textarea",
            "field": "notes",
            "label": "Notes for the visual system",
            "placeholder": "What to change, in your words (optional)",
            "rows": 3
          }
        ],
        "example": {
          "headline": "3 grounds · 4 type steps · 2 compositions · accent .is-unowned",
          "grounds": [
            {
              "id": "paper",
              "name": "Paper",
              "hex": "#EEEDE8",
              "ink": "#1A1A1A",
              "job": "Evidence: charts, tables, quotes"
            },
            {"id": "ink", "name": "Ink", "hex": "#16181D", "ink": "#F4F3EE", "job": "Resets between sections"},
            {"id": "mist", "name": "Mist", "hex": "#DDE3E8", "ink": "#16181D", "job": "Quotes and testimony"}
          ],
          "typeSteps": [
            {"id": "hero", "name": "Hero number", "px": 220, "family": "system sans", "weight": 700},
            {"id": "title", "name": "Slide title", "px": 64, "family": "system sans", "weight": 600},
            {"id": "body", "name": "Body", "px": 36, "family": "system sans", "weight": 400},
            {"id": "caption", "name": "Caption", "px": 24, "family": "system sans", "weight": 400}
          ],
          "compositions": [
            {"id": "statement", "name": "Statement", "job": "One sentence, nothing else", "slides": 4},
            {"id": "hero-number", "name": "Hero number", "job": "One number and its caption", "slides": 3}
          ],
          "accent": "Signal #FF5A1F: marks the one cost nobody owns (class .is-unowned)",
          "sheet": "preview/system-sheet.png",
          "compositionsSheet": "preview/compositions.png",
          "samples": "preview/samples.png"
        }
      }
    }
  }
}
