{
  "key": "deckNarrative",
  "metaVersion": 2,
  "mockRole": "generic-producer",
  "promptHints": "Write the hallway sentence, the three-to-five section spine, and a takeaway title for every planned slide. Nothing visual yet. Pipeline directory: {pipelineDir}",
  "inputs": [
    { "id": "task", "type": "md" },
    { "id": "answers", "type": "json", "required": false, "as": "answers" }
  ],
  "outputs": [{ "id": "spine", "type": "md", "filename": "spine.md", "artifactKind": "deck-spine" }],
  "domain": "presentation",
  "displayName": "Narrative Spine",
  "description": "Turns the brief and the clarify answers into one hallway sentence, a 3–5 section spine and a takeaway title per slide.",
  "color": "amber",
  "icon": "<path d=\"M5 6h14M5 12h10M5 18h7\" stroke-linecap=\"round\"/>",
  "agentFile": "worca-cc-deck-narrative.md",
  "runnerType": "producer",
  "asksQuestions": true,
  "questionsLocked": false,
  "questionsDefault": true,
  "order": 11,
  "ask": {
    "forms": {
      "approve-spine": {
        "version": 1,
        "title": "Approve the narrative spine",
        "data": {
          "type": "object",
          "required": ["headline", "sentence", "sections", "slides", "spine"],
          "properties": {
            "headline": {"type": "string", "maxLength": 240},
            "sentence": {"type": "string", "maxLength": 600},
            "sections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": {"type": "string", "maxLength": 32},
                  "name": {"type": "string", "maxLength": 120},
                  "establishes": {"type": "string", "maxLength": 400}
                }
              }
            },
            "slides": {
              "type": "array",
              "minItems": 1,
              "maxItems": 60,
              "items": {
                "type": "object",
                "required": ["id", "title"],
                "properties": {
                  "id": {"type": "string", "maxLength": 16},
                  "title": {"type": "string", "maxLength": 400},
                  "meta": {"type": "string", "maxLength": 240}
                }
              }
            },
            "spine": {"type": "file", "accept": ["text/*"]}
          }
        },
        "answer": {
          "type": "object",
          "required": ["decision", "sentence"],
          "properties": {
            "decision": {"type": "string", "enum": ["approve", "changes"], "default": "approve"},
            "sentence": {"type": "string", "maxLength": 600, "defaultFrom": "data.sentence"},
            "sectionOrder": {"type": "array", "items": {"type": "string", "enumFrom": "data.sections[].id"}},
            "slides": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "verdict"],
                "properties": {
                  "id": {"type": "string", "enumFrom": "data.slides[].id"},
                  "verdict": {"type": "string", "enum": ["keep", "rework", "cut"], "default": "keep"},
                  "note": {"type": "string", "maxLength": 1000}
                }
              }
            },
            "notes": {"type": "string", "maxLength": 4000}
          }
        },
        "layout": [
          {"widget": "callout", "title": "Narrative spine", "bind": "data.headline", "tone": "info"},
          {
            "widget": "textarea",
            "field": "sentence",
            "label": "Hallway sentence",
            "help": "The one sentence someone repeats in the hallway afterwards. Edit it to change it.",
            "rows": 3
          },
          {
            "widget": "tabs",
            "tabs": [
              {
                "label": "Story",
                "children": [
                  {
                    "widget": "rank",
                    "bind": "data.sections",
                    "field": "sectionOrder",
                    "label": "Section order",
                    "help": "Drag to reorder the story. Slides move with their section.",
                    "titleKey": "name",
                    "metaKey": "establishes"
                  }
                ]
              },
              {
                "label": "Slides",
                "children": [
                  {
                    "widget": "review-list",
                    "bind": "data.slides",
                    "field": "slides",
                    "label": "Slides",
                    "titleKey": "title",
                    "metaKey": "meta",
                    "labels": {"keep": "Keep", "rework": "Rework", "cut": "Cut"},
                    "tones": {"keep": "ok", "rework": "warn", "cut": "bad"},
                    "notePlaceholder": "What should change on this slide?"
                  }
                ]
              },
              {"label": "Full spine.md", "children": [{"widget": "markdown", "bind": "data.spine"}]}
            ]
          },
          {
            "widget": "select",
            "field": "decision",
            "label": "Decision",
            "style": "segmented",
            "labels": {"approve": "Approve the spine", "changes": "Apply my changes"},
            "tones": {"approve": "ok", "changes": "warn"},
            "help": "Any edit above counts as a change, whichever you pick."
          },
          {
            "widget": "textarea",
            "field": "notes",
            "label": "Notes for the narrative",
            "placeholder": "Anything else to change (optional)",
            "rows": 3
          }
        ],
        "example": {
          "headline": "Why the pilot worked — 6 slides · 3 sections",
          "sentence": "The pilot cut onboarding from nine days to two, so we should roll it out to every team this quarter.",
          "sections": [
            {"id": "s1", "name": "The problem", "establishes": "Onboarding takes nine days and costs a sprint."},
            {"id": "s2", "name": "The pilot", "establishes": "Two teams tried the new flow for six weeks."},
            {"id": "s3", "name": "The ask", "establishes": "Roll it out to every team this quarter."}
          ],
          "slides": [
            {"id": "1", "title": "Nine days to first commit", "meta": "The problem · hero"},
            {"id": "2", "title": "Where the nine days go", "meta": "The problem"},
            {"id": "3", "title": "Two teams tried a two-day path", "meta": "The pilot · reset: divider"},
            {"id": "4", "title": "Both shipped on day two", "meta": "The pilot"},
            {"id": "5", "title": "Rolling out costs one sprint", "meta": "The ask · reset: statement"},
            {"id": "6", "title": "Every team on the new path by Q4", "meta": "The ask"}
          ],
          "spine": "spine.md"
        }
      }
    }
  }
}
